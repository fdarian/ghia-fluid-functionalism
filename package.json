{
	"name": "ghia-fluid-functionalism-workspace",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"scripts": {
		"start": "pnpm --filter ghia-fluid-functionalism-demo start",
		"build": "pnpm --filter ghia-fluid-functionalism-demo build",
		"check": "turbo run check",
		"check:type": "turbo run check:type",
		"check:scenarios": "turbo run check:scenarios",
		"screenshots": "pnpm --filter ghia-fluid-functionalism-demo screenshots",
		"perf": "pnpm --filter ghia-fluid-functionalism-demo perf",
		"footprint": "pnpm --filter ghia-fluid-functionalism-demo footprint",
		"format": "biome check --write",
		"ci:version": "changeset version",
		"ci:release": "pnpm --filter ghia-fluid-functionalism build && pnpm --filter ghia-fluid-functionalism-demo release:binary && changeset publish"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@changesets/cli": "3.0.3",
		"turbo": "2.11.10"
	}
}
